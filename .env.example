# ── Server (npm run api / npm start) ─────────────────────────────────────────
# Which data source feeds the board: demo (default, no keys) | recorded (real days, no keys) | upstox | <your adapter>
MF_PROVIDER=demo
PORT=8787
# Who can reach the server: 127.0.0.1 = this machine only (default). Use 0.0.0.0
# only together with MF_BASIC_AUTH, or behind a proxy that signs people in.
HOST=127.0.0.1
# Password-protect every route: user:password (password of 8+ characters)
# MF_BASIC_AUTH=
# Allow one other origin to read the API (only when the page is hosted elsewhere)
# MF_CORS_ORIGIN=https://order-flow.example.com
# Where the server keeps today's minute snapshots
MF_DATA_DIR=server/data

# Recorded sessions (MF_PROVIDER=recorded): which day to replay (default: the newest)
# MF_RECORDED_DATE=2026-10-30
# MF_RECORDED_DIR=data/recorded

# Upstox (MF_PROVIDER=upstox): the day's access token from the OAuth login
# UPSTOX_ACCESS_TOKEN=

# ── Page (npm run dev / npm run build) ───────────────────────────────────────
# Only when the page is served from a different origin than the server
# VITE_API_BASE=https://market-flow.example.com
